# .env.example
# ─────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your own values.
# .env is listed in .gitignore and will NEVER be committed.
#
# Kaggle API credentials
# Get yours at: https://www.kaggle.com/settings → "Create New Token"
# ─────────────────────────────────────────────────────────────────────────

KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# AI agent (Final Project) — OpenRouter
# Get a key at: https://openrouter.ai/settings/keys
# The default model is cheap and reliable for tool-calling.
# For a zero-cost option, pick any free model from
# https://openrouter.ai/models?max_price=0 and set it below.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your_openrouter_api_key
LLM_MODEL=openai/gpt-4o-mini
