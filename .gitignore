### DATA ###
# Ignore processed data and databases
/data/processed/*
/data/db/*

# Preserve raw data structure but ignore large files
/data/raw/*.xlsx
/data/raw/*.csv
/data/raw/*.zip

### REPORTS ###
# Ignore scratch / html exports
/reports/*.html
/reports/*.png

### ENVIRONMENT ###
.venv/
env/
venv/
# .env contains secrets – NEVER commit it
.env
# .env.example should be committed (it has no real secrets)
environment.yml

### PYTHON ###
__pycache__/
*.pyc
*.pyo
*.pyd
*.pycache

### NOTEBOOKS ###
.ipynb_checkpoints/

### IDE ###
.vscode/
.idea/
*.iml
*.ipr
*.iws

### SYSTEM ###
*.log
*.lock
.DS_Store
Thumbs.db

### SENSITIVE – never commit these ###
kaggle.json
*.key
*.pem
secrets.ini
*.secret